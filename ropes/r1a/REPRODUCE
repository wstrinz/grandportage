#!/usr/bin/env bash
# Rope R1a: one command, from the rope directory, on Linux (Landlock kernel, non-root user; elan, git, Go >= 1.24 on PATH):
#   bash REPRODUCE
# Builds pinned Comparator, lean4export and landrun for the rope's toolchain, fetches the Mathlib cache, builds the
# rope, runs stock Comparator on the 9 challenges (each must print "Your solution is okay") and on the 4 controls
# (each must be refused with its expected reason). Exit 0 iff all 13 behave. Tools go to $R1A_TOOLS
# (default ./.lake/r1a-tools); logs go to ./.lake/r1a-logs.
set -u
cd "$(dirname "$0")"
step() { echo "[$(date -u +%H:%M:%S)] $*"; }
die() { echo "REPRODUCE: $*" >&2; exit 2; }

step "preflight"
command -v elan >/dev/null || die "elan not found on PATH (install: https://github.com/leanprover/elan)"
command -v lake >/dev/null || die "lake not found on PATH (it comes with elan: add ~/.elan/bin to PATH)"
command -v git >/dev/null || die "git not found on PATH"
command -v go >/dev/null || die "Go not found on PATH (https://go.dev/dl/, version 1.24 or later; needed for landrun)"

TOOLCHAIN=$(cat lean-toolchain)                           # leanprover/lean4:v4.34.1
COMPARATOR_REV=d03acab154d269c06e60e4de7e4cc85deebff94b   # leanprover/comparator tag v4.34.0
LEAN4EXPORT_REV=076e8e57707e813375e8f9da8bf989799ace9680  # leanprover/lean4export tag v4.34.0
LANDRUN_REV=811cfff51ceaf3d9843708aa6d22e9b84ccac8b4      # Zouuup/landrun main, as Comparator's README asks
T=${R1A_TOOLS:-$PWD/.lake/r1a-tools}
LOGS=$PWD/.lake/r1a-logs
mkdir -p "$T/src" "$T/bin" "$LOGS"

step "fetching comparator, lean4export, landrun"
for spec in "comparator https://github.com/leanprover/comparator.git $COMPARATOR_REV" \
            "lean4export https://github.com/leanprover/lean4export.git $LEAN4EXPORT_REV" \
            "landrun https://github.com/Zouuup/landrun.git $LANDRUN_REV"; do
  set -- $spec
  [ -d "$T/src/$1" ] || git clone --quiet "$2" "$T/src/$1" || die "cloning $1 failed"
  git -C "$T/src/$1" checkout --quiet "$3" || die "checking out $1 $3 failed"
done
# No v4.34.1 tag exists for comparator or lean4export: build the v4.34.0 sources with the rope's toolchain.
for t in comparator lean4export; do
  step "building $t with $TOOLCHAIN"
  echo "$TOOLCHAIN" > "$T/src/$t/lean-toolchain"
  (cd "$T/src/$t" && lake build "$t" >"$LOGS/build-$t.log" 2>&1) || die "building $t failed (see $LOGS/build-$t.log)"
  ln -sf "$T/src/$t/.lake/build/bin/$t" "$T/bin/$t"
done
step "building landrun"
(cd "$T/src/landrun" && go build -o "$T/bin/landrun" cmd/landrun/main.go) >"$LOGS/build-landrun.log" 2>&1 \
  || die "building landrun failed (see $LOGS/build-landrun.log)"
export PATH="$T/bin:$PATH"

step "fetching the Mathlib cache"
lake exe cache get >"$LOGS/cache.log" 2>&1 || die "lake exe cache get failed (see $LOGS/cache.log)"
step "building the rope, its challenges and controls"
lake build UDGRope R1aChallenge R1aControl >"$LOGS/build-rope.log" 2>&1 || die "rope build failed (see $LOGS/build-rope.log)"

run() {  # Comparator under systemd-run --user when available (Comparator's README), else directly
  if systemd-run --user --wait --pipe -q true 2>/dev/null; then
    systemd-run --property=RestrictAddressFamilies=~AF_UNIX --user --wait --pipe -q \
      -E PATH="$PATH" -E HOME="$HOME" --working-directory "$PWD" -- lake env comparator "$1"
  else
    lake env comparator "$1"
  fi
}
fail=0
for n in rhombus gadget0 gadget1 gadget2 gadget3 gadget4 gadget5 heredity schade; do
  step "comparator $n"
  run "comparator/$n.json" >"$LOGS/$n.log" 2>&1
  if grep -q "Your solution is okay" "$LOGS/$n.log"; then echo "  accepted  $n"
  else echo "  FAILED    $n (expected acceptance; see $LOGS/$n.log)"; fail=1; fi
done
# A control counts as refused only when Comparator ran and gave the expected reason.
for spec in "ctl-sorrygadget0|Illegal axiom detected: 'sorryAx'" \
            "ctl-axiomgadget1|Illegal axiom detected: 'UDGRope.cheat'" \
            "ctl-weakerrhombus|statement do not match: 'UDGRope.rhombus'" \
            "ctl-redefschade|Const does not match between challenge and target 'UDGRope.maxUnitDistances'"; do
  n=${spec%%|*}; reason=${spec#*|}
  step "comparator $n (control)"
  run "comparator/$n.json" >"$LOGS/$n.log" 2>&1
  if grep -q "Your solution is okay" "$LOGS/$n.log"; then echo "  FAILED    $n (control accepted)"; fail=1
  elif grep -qF "$reason" "$LOGS/$n.log"; then echo "  refused   $n: $reason"
  else echo "  FAILED    $n (no expected refusal reason; see $LOGS/$n.log)"; fail=1; fi
done
[ $fail -eq 0 ] && step "all 13 as expected" || step "FAILURES above"
exit $fail
