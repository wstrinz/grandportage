{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gp-cost-log/v2",
  "title": "Campaign cost log entry (one JSON object per line)",
  "description": "Post-G3a handoff §3 and post-G2 §6 (prospective Phase 5 schema): wall time, tokens, agent turns, catches, false refusals and expensive near-misses, per task. v2 adds Phase 5's comparative arms (rev 3 §9, post-G4 §8) and workability metrics; every v1 entry remains valid. See docs/PHASE-5-COST-LOG.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "stage",
    "started",
    "ended",
    "wall_seconds",
    "agent_turns",
    "tokens",
    "catches",
    "false_refusals",
    "near_misses"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "A stable task id, e.g. F0-fano-char2."
    },
    "stage": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "tutorial",
        "u22",
        "arm",
        "other"
      ]
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "ended": {
      "type": "string",
      "format": "date-time"
    },
    "wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "agent_turns": {
      "type": "integer",
      "minimum": 0
    },
    "tokens": {
      "description": "Token counts where the harness reports them; null when unavailable.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output"
          ],
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "catches": {
      "type": "array",
      "description": "Real errors GP stopped in this task.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "what"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "false_refusals": {
      "type": "integer",
      "minimum": 0,
      "description": "Sound claims refused; each also has a friction-log entry."
    },
    "near_misses": {
      "type": "array",
      "description": "Errors that almost got through, or cost a lot to avoid.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "cost"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "arm": {
      "enum": [
        "gp",
        "lean-comparator",
        "notebook"
      ],
      "description": "G5 comparative arm: (a) the core, (b) Lean plus Comparator, (c) notebook plus checker scripts plus CI."
    },
    "incident": {
      "type": "string",
      "minLength": 1,
      "description": "Incident id: home (INCIDENT-INVENTORY.md) or foreign (reports/FOREIGN-SET.json)."
    },
    "incident_set": {
      "enum": [
        "home",
        "foreign"
      ]
    },
    "outcome": {
      "enum": [
        "caught",
        "missed"
      ],
      "description": "Whether this arm caught the incident's error."
    },
    "time_to_first_held_seconds": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "description": "Wall seconds from task start to the first held claim (G5 workability); null if none was held."
    },
    "obligations_resolved": {
      "type": "integer",
      "minimum": 0,
      "description": "Obligations resolved (held or refused with a recorded reason) in this task (G5 workability: agent turns per resolved obligation)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "arm"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "arm",
          "incident",
          "incident_set",
          "outcome",
          "time_to_first_held_seconds",
          "obligations_resolved"
        ]
      }
    }
  ]
}
