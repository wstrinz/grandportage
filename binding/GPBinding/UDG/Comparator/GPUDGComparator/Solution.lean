-- source: binding/GPBinding/UDG/Rope/UDGRope/Basic.lean
/-!
Coordinates in the plane, heredity (P3) and the unit-pair count of an embedded vertex set.

- `dist_eq_one_iff`, `eq_iff_sq`: distance 1 and equality of plane points in coordinates.
- `heredity` (P3, L1): Mathlib's `UnitDistEmbedding.copy`, re-exported.
- `unitDistNum_map`: the unit pairs of `f(V)` for an injective `f` are the edges of the unit graph
  `unitGraph f` (every pair of distinct vertices at distance 1), so the count is its edge count.
-/

noncomputable section

namespace UDGRope
open scoped Finset

theorem dist_sq (p q : ℝ²) : dist p q ^ 2 = (p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2 := by
  rw [EuclideanSpace.dist_eq, Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _), Fin.sum_univ_two, Real.dist_eq,
    Real.dist_eq, sq_abs, sq_abs]

theorem dist_eq_one_iff (p q : ℝ²) :
    dist p q = 1 ↔ (p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2 = 1 := by
  rw [← dist_sq]
  constructor
  · intro h; rw [h]; norm_num
  · intro h
    have h0 : 0 ≤ dist p q := dist_nonneg
    nlinarith [sq_nonneg (dist p q - 1), sq_nonneg (dist p q + 1)]

theorem eq_iff_sq (p q : ℝ²) : p = q ↔ (p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2 = 0 := by
  constructor
  · rintro rfl; ring
  · intro h
    have h0 : p 0 - q 0 = 0 := by nlinarith [sq_nonneg (p 0 - q 0), sq_nonneg (p 1 - q 1)]
    have h1 : p 1 - q 1 = 0 := by nlinarith [sq_nonneg (p 0 - q 0), sq_nonneg (p 1 - q 1)]
    ext i
    fin_cases i
    · exact sub_eq_zero.mp h0
    · exact sub_eq_zero.mp h1

/-- The plane point with coordinates `(a, b)`. -/
abbrev pt (a b : ℝ) : ℝ² := !₂[a, b]

@[simp] theorem pt_zero (a b : ℝ) : pt a b 0 = a := rfl
@[simp] theorem pt_one (a b : ℝ) : pt a b 1 = b := rfl

/-- **P3 (L1, heredity).** A unit-distance embedding of `G` restricts along any copy of `H` in `G`
(not necessarily induced): Mathlib's `SimpleGraph.UnitDistEmbedding.copy`. -/
def heredity {V W E : Type*} [MetricSpace E] {G : SimpleGraph V} {H : SimpleGraph W}
    (U : G.UnitDistEmbedding E) (f : H.Copy G) : H.UnitDistEmbedding E :=
  U.copy f

theorem heredity_nonempty {V W E : Type*} [MetricSpace E] {G : SimpleGraph V} {H : SimpleGraph W}
    (f : H.Copy G) (h : Nonempty (G.UnitDistEmbedding E)) : Nonempty (H.UnitDistEmbedding E) :=
  h.map fun U => U.copy f

/-! ## Counting unit pairs -/

/-- The unit graph of a point map: distinct vertices at distance 1. -/
def unitGraph {V X : Type*} [MetricSpace X] (f : V → X) : SimpleGraph V where
  Adj u v := u ≠ v ∧ dist (f u) (f v) = 1
  symm := ⟨fun u v h => ⟨h.1.symm, by rw [dist_comm]; exact h.2⟩⟩
  loopless := ⟨fun u h => h.1 rfl⟩

theorem dist_out {X : Type*} [MetricSpace X] (p : Sym2 X) :
    dist p.out.1 p.out.2 = Sym2.lift ⟨fun a b => dist a b, fun a b => dist_comm a b⟩ p := by
  conv_rhs => rw [← Quot.out_eq p]
  rfl

theorem unitDistNum_eq {X : Type*} [MetricSpace X] (s : Finset X) :
    unitDistNum s = #{p ∈ s.sym2 | Sym2.lift ⟨fun a b => dist a b, fun a b => dist_comm a b⟩ p = 1} := by
  unfold unitDistNum
  congr 1
  ext p
  simp only [Finset.mem_filter, dist_out]

/-- The unit pairs of an injectively embedded vertex set are the edges of the unit graph. -/
theorem unitDistNum_map {V X : Type*} [Fintype V] [MetricSpace X] (f : V ↪ X)
    [DecidableRel (unitGraph f).Adj] :
    unitDistNum (Finset.univ.map f) = #(unitGraph f).edgeFinset := by
  classical
  rw [unitDistNum_eq, Finset.sym2_map, Finset.filter_map, Finset.card_map]
  congr 1
  ext e
  induction e using Sym2.ind with
  | h u v =>
    rw [Finset.mem_filter, SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet]
    simp only [Finset.mem_sym2_iff, Finset.mem_univ, implies_true, true_and, Function.comp_apply,
      Function.Embedding.sym2Map_apply, Sym2.map_mk, Sym2.lift_mk, unitGraph]
    constructor
    · intro h
      refine ⟨fun huv => ?_, h⟩
      subst huv
      simp at h
    · exact fun h => h.2

end UDGRope

-- source: binding/GPBinding/UDG/Rope/UDGRope/Rhombus.lean
/-!
**P1, the rhombus lemma.** In an injective unit-distance embedding into the plane, every 4-cycle
`a-b-c-d` has `p a - p b + p c - p d = 0` (artwaste `check/PROOFS.md`, "Two geometric facts").

The proof is algebra in coordinates and holds over every field with `2 ≠ 0` for the quadratic form
`x² + y²` (`rhombus_field`). With `w = c - a`, `e = b - d`, `z = b + d - a - c`: the four unit
equations give `⟨e, w⟩ = ⟨z, w⟩ = ⟨z, e⟩ = 0`, so `z · det(w, e) = 0`. If the determinant vanishes,
Lagrange's identity forces `w` or `e` to be isotropic, and each case collapses `a = c` or `b = d`.

Controls:
- `rhombus_needs_injective`: without injectivity the conclusion fails (`a` and `c` collide).
- Over `ℂ²` with the bilinear form, the lemma still **holds** for injective maps
  (`rhombus_complex`), contrary to the packet's expected control (HW61 §3, P1). What fails over `ℂ`
  is the frame's reading of injectivity as the guard `Δx² + Δy² ≠ 0`
  (`complex_isotropic_pair`: distinct points with zero squared distance).
-/

namespace UDGRope

section Field
variable {K : Type*} [Field K]

/-- The rhombus lemma in coordinates, over any field with `2 ≠ 0`. -/
theorem rhombus_field (h2 : (2 : K) ≠ 0) {a0 a1 b0 b1 c0 c1 d0 d1 : K}
    (hab : (a0 - b0) ^ 2 + (a1 - b1) ^ 2 = 1) (hbc : (b0 - c0) ^ 2 + (b1 - c1) ^ 2 = 1)
    (hcd : (c0 - d0) ^ 2 + (c1 - d1) ^ 2 = 1) (hda : (d0 - a0) ^ 2 + (d1 - a1) ^ 2 = 1)
    (hac : ¬ (a0 = c0 ∧ a1 = c1)) (hbd : ¬ (b0 = d0 ∧ b1 = d1)) :
    a0 - b0 + c0 - d0 = 0 ∧ a1 - b1 + c1 - d1 = 0 := by
  -- w = c - a, e = b - d, z = b + d - a - c, u = b - a
  have hew : (b0 - d0) * (c0 - a0) + (b1 - d1) * (c1 - a1) = 0 := by
    have : 2 * ((b0 - d0) * (c0 - a0) + (b1 - d1) * (c1 - a1)) = 0 := by
      linear_combination hab - hbc - hda + hcd
    simpa [h2] using this
  have hzw : (b0 + d0 - a0 - c0) * (c0 - a0) + (b1 + d1 - a1 - c1) * (c1 - a1) = 0 := by
    have : 2 * ((b0 + d0 - a0 - c0) * (c0 - a0) + (b1 + d1 - a1 - c1) * (c1 - a1)) = 0 := by
      linear_combination hab - hbc + hda - hcd
    simpa [h2] using this
  have hze : (b0 + d0 - a0 - c0) * (b0 - d0) + (b1 + d1 - a1 - c1) * (b1 - d1) = 0 := by
    linear_combination hab - hda - hew
  have hz0 : (b0 + d0 - a0 - c0) * ((c0 - a0) * (b1 - d1) - (c1 - a1) * (b0 - d0)) = 0 := by
    linear_combination (b1 - d1) * hzw - (c1 - a1) * hze
  have hz1 : (b1 + d1 - a1 - c1) * ((c0 - a0) * (b1 - d1) - (c1 - a1) * (b0 - d0)) = 0 := by
    linear_combination (c0 - a0) * hze - (b0 - d0) * hzw
  have sq0 : ∀ t : K, 2 * t ^ 2 = 0 → t = 0 := fun t ht => by
    have : t ^ 2 = 0 := by simpa [h2] using ht
    exact pow_eq_zero_iff (two_ne_zero) |>.mp this
  -- `w` is not isotropic: else `u ⊥ w` and `u ∥ w` force `w = 0`
  have hQw : (c0 - a0) ^ 2 + (c1 - a1) ^ 2 ≠ 0 := by
    intro hw
    have huw : (b0 - a0) * (c0 - a0) + (b1 - a1) * (c1 - a1) = 0 := by
      have : 2 * ((b0 - a0) * (c0 - a0) + (b1 - a1) * (c1 - a1)) = 0 := by
        linear_combination hab - hbc + hw
      simpa [h2] using this
    have hD' : ((c0 - a0) * (b1 - a1) - (c1 - a1) * (b0 - a0)) ^ 2 = 0 := by
      linear_combination ((b0 - a0) ^ 2 + (b1 - a1) ^ 2) * hw -
        ((b0 - a0) * (c0 - a0) + (b1 - a1) * (c1 - a1)) * huw
    have hD'0 := pow_eq_zero_iff two_ne_zero |>.mp hD'
    have hsq : (c0 - a0) ^ 2 = (c1 - a1) ^ 2 := by
      linear_combination ((c0 - a0) * (b0 - a0) - (c1 - a1) * (b1 - a1)) * huw +
        ((c0 - a0) * (b1 - a1) + (c1 - a1) * (b0 - a0)) * hD'0 - ((c0 - a0) ^ 2 - (c1 - a1) ^ 2) * hab
    have h0 := sq0 (c0 - a0) (by linear_combination hw + hsq)
    have h1 : c1 - a1 = 0 := pow_eq_zero_iff two_ne_zero |>.mp (by rw [← hsq, h0]; ring)
    exact hac ⟨by linear_combination -h0, by linear_combination -h1⟩
  by_cases hD0 : ((c0 - a0) * (b1 - d1) - (c1 - a1) * (b0 - d0)) = 0
  · -- then `e` is isotropic, and `e ⊥ w`, `e ∥ w` force `e = 0`
    exfalso
    have hQe : (b0 - d0) ^ 2 + (b1 - d1) ^ 2 = 0 := by
      have : ((c0 - a0) ^ 2 + (c1 - a1) ^ 2) * ((b0 - d0) ^ 2 + (b1 - d1) ^ 2) = 0 := by
        linear_combination ((b0 - d0) * (c0 - a0) + (b1 - d1) * (c1 - a1)) * hew + ((c0 - a0) * (b1 - d1) - (c1 - a1) * (b0 - d0)) * hD0
      exact (mul_eq_zero.mp this).resolve_left hQw
    have hsq : ((c0 - a0) ^ 2 + (c1 - a1) ^ 2) * ((b0 - d0) ^ 2 - (b1 - d1) ^ 2) = 0 := by
      linear_combination ((b0 - d0) * (c0 - a0) - (b1 - d1) * (c1 - a1)) * hew -
        ((b0 - d0) * (c1 - a1) + (b1 - d1) * (c0 - a0)) * hD0
    have hsq' := (mul_eq_zero.mp hsq).resolve_left hQw
    have h0 := sq0 (b0 - d0) (by linear_combination hQe + hsq')
    have h1 : b1 - d1 = 0 := pow_eq_zero_iff two_ne_zero |>.mp (by linear_combination hQe - (b0 - d0) * h0)
    exact hbd ⟨by linear_combination h0, by linear_combination h1⟩
  · have e0 := (mul_eq_zero.mp hz0).resolve_right hD0
    have e1 := (mul_eq_zero.mp hz1).resolve_right hD0
    exact ⟨by linear_combination -e0, by linear_combination -e1⟩

end Field

/-- **P1 (rhombus lemma).** In an injective unit-distance embedding into the Euclidean plane,
every 4-cycle `a-b-c-d` (closed, with `a ≠ c` and `b ≠ d`) has `p a - p b + p c - p d = 0`. -/
theorem rhombus {V : Type*} {G : SimpleGraph V} (f : G.UnitDistEmbedding ℝ²) {a b c d : V}
    (hab : G.Adj a b) (hbc : G.Adj b c) (hcd : G.Adj c d) (hda : G.Adj d a)
    (hac : a ≠ c) (hbd : b ≠ d) :
    f.p a - f.p b + f.p c - f.p d = 0 := by
  have u1 := (dist_eq_one_iff _ _).mp (f.unit_dist hab)
  have u2 := (dist_eq_one_iff _ _).mp (f.unit_dist hbc)
  have u3 := (dist_eq_one_iff _ _).mp (f.unit_dist hcd)
  have u4 := (dist_eq_one_iff _ _).mp (f.unit_dist hda)
  have nac : ¬ (f.p a 0 = f.p c 0 ∧ f.p a 1 = f.p c 1) := fun h =>
    hac (f.p.injective (PiLp.ext fun i => by fin_cases i; exacts [h.1, h.2]))
  have nbd : ¬ (f.p b 0 = f.p d 0 ∧ f.p b 1 = f.p d 1) := fun h =>
    hbd (f.p.injective (PiLp.ext fun i => by fin_cases i; exacts [h.1, h.2]))
  obtain ⟨h0, h1⟩ := rhombus_field two_ne_zero u1 u2 u3 u4 nac nbd
  ext i
  fin_cases i
  · simpa using h0
  · simpa using h1

/-- Control: without injectivity the rhombus lemma fails (`a = c`, `b ≠ d`). -/
theorem rhombus_needs_injective :
    ∃ p : Fin 4 → ℝ², dist (p 0) (p 1) = 1 ∧ dist (p 1) (p 2) = 1 ∧ dist (p 2) (p 3) = 1 ∧
      dist (p 3) (p 0) = 1 ∧ p 0 - p 1 + p 2 - p 3 ≠ 0 := by
  refine ⟨![pt 0 0, pt 1 0, pt 0 0, pt 0 1], ?_, ?_, ?_, ?_, ?_⟩
  · rw [dist_eq_one_iff]; simp
  · rw [dist_eq_one_iff]; simp
  · rw [dist_eq_one_iff]; simp
  · rw [dist_eq_one_iff]; simp
  · intro h
    have := congrArg (fun v : ℝ² => v 0) h
    simp at this

/-- Over `ℂ²` with the bilinear form the rhombus lemma still holds for injective maps: the packet's
expected failing control does not fail. -/
theorem rhombus_complex (p : Fin 4 → Fin 2 → ℂ) (hp : Function.Injective p)
    (h : ∀ i : Fin 4, (p i 0 - p (i + 1) 0) ^ 2 + (p i 1 - p (i + 1) 1) ^ 2 = 1) :
    p 0 - p 1 + p 2 - p 3 = 0 := by
  have ne : ∀ i j : Fin 4, i ≠ j → ¬ (p i 0 = p j 0 ∧ p i 1 = p j 1) := fun i j hij h' =>
    hij (hp (funext fun k => by fin_cases k; exacts [h'.1, h'.2]))
  obtain ⟨h0, h1⟩ := rhombus_field two_ne_zero (h 0) (h 1) (h 2) (h 3) (ne 0 2 (by decide))
    (ne 1 3 (by decide))
  funext k
  fin_cases k
  · simpa using h0
  · simpa using h1

/-- What does fail over `ℂ`: distinct points at squared distance 0, so the guard
`Δx² + Δy² ≠ 0` is stronger than injectivity there (M5 pitfall 3). -/
theorem complex_isotropic_pair :
    ∃ p q : Fin 2 → ℂ, p ≠ q ∧ (p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2 = 0 := by
  refine ⟨![1, Complex.I], 0, fun h => by simpa using congrFun h 0, ?_⟩
  simp

end UDGRope

-- source: binding/GPBinding/UDG/Rope/UDGRope/Gadgets.lean
/-!
**P2, the six totally unfaithful (TU) gadgets.** For each gadget of artwaste's
`data/tu-gadgets.json` (`artwasteland/Maths` at `ba1c76fd`): the distinguished pair is not an
edge, and in every injective unit-distance embedding into the plane its displacement equals an
edge's, so the pair is at distance 1. Each proof is the integer combination of rhombus relations
(P1) given in artwaste's `check/PROOFS.md`, with the cycles named there; `R(a,b,c,d)` is
`p a - p b + p c - p d`.

| gadget | pair | combination | forced equal to edge |
|---|---|---|---|
| 0 | 1 5 | `-R(0,1,2,3) + R(2,3,4,5)` | 0 4 |
| 1 | 4 5 | `-R(0,3,2,4) + R(1,3,2,6) - R(1,2,5,6)` | 0 2 |
| 2 | 2 4 | `-R(0,2,1,3) + R(0,2,5,4) + R(1,3,2,6) - R(1,2,5,6)` | 1 2 |
| 3 | 3 7 | `R(0,1,3,2) - R(0,2,5,6) + R(1,3,4,7) - R(2,3,4,5)` | 2 6 |
| 4 | 6 7 | `-R(0,2,5,6) + R(1,3,4,7) - R(2,3,4,5)` (gadget 3's graph) | 0 1 |
| 5 | 6 7 | the same, without edge 2 6 | 0 1 |
-/

namespace UDGRope

/-- Equal displacement to an edge's gives distance 1. -/
theorem dist_of_disp {V : Type*} {G : SimpleGraph V} (f : G.UnitDistEmbedding ℝ²) {a b u v : V}
    (huv : G.Adj u v) (h : f.p a - f.p b = f.p u - f.p v) : dist (f.p a) (f.p b) = 1 := by
  rw [dist_eq_norm, h, ← dist_eq_norm]
  exact f.unit_dist huv

/-- **Gadget 0** is totally unfaithful: pair (1, 5), forced equal to edge 0 4. -/
theorem gadget0_tu :
    ¬ gadget0.Adj 1 5 ∧ ∀ f : gadget0.UnitDistEmbedding ℝ², dist (f.p 1) (f.p 5) = 1 := by
  refine ⟨by simp [gadget0], fun f => dist_of_disp f (u := 0) (v := 4) (by simp [gadget0]) ?_⟩
  have r1 := rhombus f (a := 0) (b := 1) (c := 2) (d := 3) (by simp [gadget0]) (by simp [gadget0])
    (by simp [gadget0]) (by simp [gadget0]) (by decide) (by decide)
  have r2 := rhombus f (a := 2) (b := 3) (c := 4) (d := 5) (by simp [gadget0]) (by simp [gadget0])
    (by simp [gadget0]) (by simp [gadget0]) (by decide) (by decide)
  linear_combination (norm := module) -r1 + r2

/-- **Gadget 1** is totally unfaithful: pair (4, 5), forced equal to edge 0 2. -/
theorem gadget1_tu :
    ¬ gadget1.Adj 4 5 ∧ ∀ f : gadget1.UnitDistEmbedding ℝ², dist (f.p 4) (f.p 5) = 1 := by
  refine ⟨by simp [gadget1], fun f => dist_of_disp f (u := 0) (v := 2) (by simp [gadget1]) ?_⟩
  have r2 := rhombus f (a := 0) (b := 3) (c := 2) (d := 4) (by simp [gadget1]) (by simp [gadget1])
    (by simp [gadget1]) (by simp [gadget1]) (by decide) (by decide)
  have r3 := rhombus f (a := 1) (b := 3) (c := 2) (d := 6) (by simp [gadget1]) (by simp [gadget1])
    (by simp [gadget1]) (by simp [gadget1]) (by decide) (by decide)
  have r4 := rhombus f (a := 1) (b := 2) (c := 5) (d := 6) (by simp [gadget1]) (by simp [gadget1])
    (by simp [gadget1]) (by simp [gadget1]) (by decide) (by decide)
  linear_combination (norm := module) -r2 + r3 - r4

/-- **Gadget 2** is totally unfaithful: pair (2, 4), forced equal to edge 1 2. -/
theorem gadget2_tu :
    ¬ gadget2.Adj 2 4 ∧ ∀ f : gadget2.UnitDistEmbedding ℝ², dist (f.p 2) (f.p 4) = 1 := by
  refine ⟨by simp [gadget2], fun f => dist_of_disp f (u := 1) (v := 2) (by simp [gadget2]) ?_⟩
  have r1 := rhombus f (a := 0) (b := 2) (c := 1) (d := 3) (by simp [gadget2]) (by simp [gadget2])
    (by simp [gadget2]) (by simp [gadget2]) (by decide) (by decide)
  have r2 := rhombus f (a := 0) (b := 2) (c := 5) (d := 4) (by simp [gadget2]) (by simp [gadget2])
    (by simp [gadget2]) (by simp [gadget2]) (by decide) (by decide)
  have r3 := rhombus f (a := 1) (b := 3) (c := 2) (d := 6) (by simp [gadget2]) (by simp [gadget2])
    (by simp [gadget2]) (by simp [gadget2]) (by decide) (by decide)
  have r4 := rhombus f (a := 1) (b := 2) (c := 5) (d := 6) (by simp [gadget2]) (by simp [gadget2])
    (by simp [gadget2]) (by simp [gadget2]) (by decide) (by decide)
  linear_combination (norm := module) -r1 + r2 + r3 - r4

/-- **Gadget 3** is totally unfaithful: pair (3, 7), forced equal to edge 2 6. -/
