  refine ⟨by simp [gadget3], fun f => dist_of_disp f (u := 2) (v := 6) (by simp [gadget3]) ?_⟩
  have r1 := rhombus f (a := 0) (b := 1) (c := 3) (d := 2) (by simp [gadget3]) (by simp [gadget3])
