-- source: binding/GPBinding/UDG/Rope/UDGRope/Schade.lean
/-!
**Schade averaging.** `u(n) ≤ ⌊n · u(n−1) / (n−2)⌋` for `n ≥ 3`, with `u` formal-conjectures'
`maxUnitDistances` (copied in `UDGRope.Defs`).

Deleting a point `r` of an `n`-point set keeps exactly the unit pairs avoiding `r`. A unit pair
`{x, y}` (with `x ≠ y`) avoids `n − 2` of the `n` points, so summing over `r` counts every unit
pair `n − 2` times: `(n − 2) · unitDistNum P = Σ_r unitDistNum (P.erase r) ≤ n · u(n − 1)`.
`schade_bound` states this with any bound `m` for `(n−1)`-point sets; `schade` is the `sSup` form.
-/

namespace UDGRope
open scoped Finset

/-- The unit pairs of `P`, in the `Sym2.lift` form of `unitDistNum_eq`. -/
noncomputable def unitPairs (P : Finset ℝ²) : Finset (Sym2 ℝ²) :=
  {p ∈ P.sym2 | Sym2.lift ⟨fun a b => dist a b, fun a b => dist_comm a b⟩ p = 1}

theorem card_unitPairs (P : Finset ℝ²) : #(unitPairs P) = unitDistNum P := (unitDistNum_eq P).symm

theorem unitDistNum_erase (P : Finset ℝ²) (r : ℝ²) :
    unitDistNum (P.erase r) = #{p ∈ unitPairs P | r ∉ p} := by
  rw [unitDistNum_eq, unitPairs, Finset.filter_filter]
  congr 1
  ext p
  induction p using Sym2.ind with
  | h x y =>
    simp only [Finset.mem_filter, Finset.mk_mem_sym2_iff, Finset.mem_erase, Sym2.mem_iff,
      Sym2.lift_mk, not_or]
    constructor
    · rintro ⟨⟨⟨h1, h2⟩, ⟨h3, h4⟩⟩, h5⟩
      exact ⟨⟨h2, h4⟩, h5, Ne.symm h1, Ne.symm h3⟩
    · rintro ⟨⟨h2, h4⟩, h5, h1, h3⟩
      exact ⟨⟨⟨Ne.symm h1, h2⟩, ⟨Ne.symm h3, h4⟩⟩, h5⟩

/-- A unit pair avoids exactly `n − 2` points of the set. -/
theorem card_avoid {P : Finset ℝ²} {p : Sym2 ℝ²} (hp : p ∈ unitPairs P) :
    #{r ∈ P | r ∉ p} = #P - 2 := by
  classical
  induction p using Sym2.ind with
  | h x y =>
    simp only [unitPairs, Finset.mem_filter, Finset.mk_mem_sym2_iff, Sym2.lift_mk] at hp
    obtain ⟨⟨hx, hy⟩, hd⟩ := hp
    have hxy : x ≠ y := by rintro rfl; simp at hd
    have : ({r ∈ P | r ∉ s(x, y)} : Finset ℝ²) = P \ {x, y} := by
      ext r; simp [Sym2.mem_iff]
    rw [this, Finset.card_sdiff_of_subset (by simp [Finset.insert_subset_iff, hx, hy]),
      Finset.card_pair hxy]

/-- Every unit pair is missed by exactly two deletions: `Σ_r unitDistNum (P.erase r) =
(#P − 2) · unitDistNum P`. -/
theorem sum_unitDistNum_erase (P : Finset ℝ²) :
    ∑ r ∈ P, unitDistNum (P.erase r) = (#P - 2) * unitDistNum P := by
  classical
  simp_rw [unitDistNum_erase, Finset.card_filter]
  rw [Finset.sum_comm, ← card_unitPairs, mul_comm, Finset.card_eq_sum_ones (unitPairs P), Finset.sum_mul]
  refine Finset.sum_congr rfl fun p hp => ?_
  rw [one_mul, ← card_avoid hp, Finset.card_filter]

/-- **Schade averaging**, bound form: if every `(n−1)`-point set has at most `m` unit pairs, every
`n`-point set (`n ≥ 3`) has at most `⌊n·m/(n−2)⌋`. -/
theorem schade_bound {n m : ℕ} (hn : 3 ≤ n)
    (hm : ∀ Q : Finset ℝ², #Q = n - 1 → unitDistNum Q ≤ m) (P : Finset ℝ²) (hP : #P = n) :
    unitDistNum P ≤ n * m / (n - 2) := by
  rw [Nat.le_div_iff_mul_le (by omega)]
  have hsum := sum_unitDistNum_erase P
  have hle : ∑ r ∈ P, unitDistNum (P.erase r) ≤ ∑ _r ∈ P, m :=
    Finset.sum_le_sum fun r hr => hm _ (by rw [Finset.card_erase_of_mem hr, hP])
  rw [Finset.sum_const, smul_eq_mul, hP] at hle
  rw [hsum, hP] at hle
  linarith [Nat.mul_comm (n - 2) (unitDistNum P)]

theorem unitDistNum_le (Q : Finset ℝ²) : unitDistNum Q ≤ (#Q + 1).choose 2 := by
  rw [unitDistNum, ← Finset.card_sym2]
  exact Finset.card_filter_le _ _

theorem unitDistanceCounts_bddAbove (n : ℕ) : BddAbove (unitDistanceCounts n) := by
  refine ⟨(n + 1).choose 2, ?_⟩
  rintro _ ⟨Q, rfl, rfl⟩
  exact unitDistNum_le Q

/-- Every `n`-point set has at most `u(n)` unit pairs (for `u(N) ≤ M` hypotheses as in P4). -/
theorem unitDistNum_le_maxUnitDistances {n : ℕ} (P : Finset ℝ²) (hP : #P = n) :
    unitDistNum P ≤ maxUnitDistances n :=
  le_csSup (unitDistanceCounts_bddAbove n) ⟨P, hP, rfl⟩

/-- **Schade averaging** (P8's first step): `u(n) ≤ ⌊n · u(n−1) / (n−2)⌋` for `n ≥ 3`, with `u` the
formal-conjectures `maxUnitDistances`. -/
theorem schade (n : ℕ) (hn : 3 ≤ n) :
    maxUnitDistances n ≤ n * maxUnitDistances (n - 1) / (n - 2) := by
  apply csSup_le'
  rintro _ ⟨P, hP, rfl⟩
  exact schade_bound hn (fun Q hQ => unitDistNum_le_maxUnitDistances Q hQ) P hP

end UDGRope

-- source: binding/GPBinding/UDG/System.lean
/-!
The unit-distance system of a graph, in Mathlib terms (the meaning half of ENCODING-FRAME for
u(22) claims, HW61 G-1). For `G` on `Fin n` the system has variables `x i, y i`, one equation
`(x i - x j)² + (y i - y j)² - 1` per edge and the guard `(x i - x j)² + (y i - y j)²` for every
pair `i < j`. Non-edges carry no constraint, so extra unit distances are allowed (M5 pitfall 4).

- `udg_system_iff`: the system has a real point exactly when `G` has a (non-faithful, injective)
  unit-distance embedding into `ℝ²` (Mathlib's `SimpleGraph.UnitDistEmbedding`).
- `udg_gauge_iff`: pinning one edge `a b` at `(0, 0)`, `(1, 0)` loses no points. Any point moves
  there by the isometry `v ↦ R (v - p a)`, `R` the rotation taking `p b - p a` to `(1, 0)`.
-/

namespace GPBinding.UDG
open UDGRope

/-- A real point of the unit-distance system of `G`. -/
def SysPoint {n : ℕ} (G : SimpleGraph (Fin n)) (x y : Fin n → ℝ) : Prop :=
  (∀ i j, G.Adj i j → (x i - x j) ^ 2 + (y i - y j) ^ 2 - 1 = 0) ∧
    ∀ i j : Fin n, i < j → (x i - x j) ^ 2 + (y i - y j) ^ 2 ≠ 0

/-- **The UDG system's meaning.** The unit-distance system of `G` (one equation per edge, a
distinctness guard per pair, nothing on non-edges) has a real point exactly when `G` has an
injective unit-distance embedding into the Euclidean plane. -/
theorem udg_system_iff {n : ℕ} (G : SimpleGraph (Fin n)) :
    (∃ x y : Fin n → ℝ, (∀ i j, G.Adj i j → (x i - x j) ^ 2 + (y i - y j) ^ 2 - 1 = 0) ∧
      ∀ i j : Fin n, i < j → (x i - x j) ^ 2 + (y i - y j) ^ 2 ≠ 0) ↔
    Nonempty (G.UnitDistEmbedding ℝ²) := by
  constructor
  · rintro ⟨x, y, he, hg⟩
    have inj : Function.Injective fun i => pt (x i) (y i) := by
      intro i j hij
      by_contra hne
      have h0 : (x i - x j) ^ 2 + (y i - y j) ^ 2 = 0 := by
        have := (eq_iff_sq _ _).mp hij; simpa using this
      rcases lt_or_gt_of_ne hne with h | h
      · exact hg i j h h0
      · exact hg j i h (by linear_combination h0)
    refine ⟨⟨⟨_, inj⟩, fun {u v} huv => ?_⟩⟩
    rw [dist_eq_one_iff]
    simpa [sub_eq_zero] using he u v huv
  · rintro ⟨f⟩
    refine ⟨fun i => f.p i 0, fun i => f.p i 1, fun i j h => ?_, fun i j h h0 => ?_⟩
    · have := (dist_eq_one_iff _ _).mp (f.unit_dist h)
      linear_combination this
    · exact h.ne (f.p.injective ((eq_iff_sq _ _).mpr h0))

/-- **Gauge.** For an edge `a b`, the system has a real point exactly when it has one with
`x a = y a = 0`, `x b = 1`, `y b = 0` (a rotation and a translation; both preserve every
squared distance). -/
theorem udg_gauge_iff {n : ℕ} (G : SimpleGraph (Fin n)) {a b : Fin n} (hab : G.Adj a b) :
    (∃ x y, SysPoint G x y) ↔ ∃ x y, SysPoint G x y ∧ x a = 0 ∧ y a = 0 ∧ x b = 1 ∧ y b = 0 := by
  constructor
  · rintro ⟨x, y, he, hg⟩
    set c := x b - x a
    set s := y b - y a
    have hcs : c ^ 2 + s ^ 2 = 1 := by have := he a b hab; linear_combination this
    have key : ∀ i j, (c * (x i - x a) + s * (y i - y a) - (c * (x j - x a) + s * (y j - y a))) ^ 2 +
        (-s * (x i - x a) + c * (y i - y a) - (-s * (x j - x a) + c * (y j - y a))) ^ 2 =
        (x i - x j) ^ 2 + (y i - y j) ^ 2 := fun i j => by
      linear_combination ((x i - x j) ^ 2 + (y i - y j) ^ 2) * hcs
    refine ⟨fun i => c * (x i - x a) + s * (y i - y a), fun i => -s * (x i - x a) + c * (y i - y a),
      ⟨fun i j h => ?_, fun i j h => ?_⟩, by ring, by ring, ?_, by ring⟩
    · rw [key]; exact he i j h
    · rw [key]; exact hg i j h
    · show c * (x b - x a) + s * (y b - y a) = 1
      linear_combination hcs
  · rintro ⟨x, y, h, -⟩
    exact ⟨x, y, h⟩

end GPBinding.UDG

-- source: binding/GPBinding/UDG/Spine.lean
/-!
The u(22) spine's soundness lemmas (HW61 P4 and G-2). Mathlib only, over the rope's vocabulary.

- `tu_hereditary` (**P4, L2**, artwaste `enum/PRUNING.md` §1 at `ba1c76fd`): if every `N`-point
  set has at most `M` unit pairs, a graph `H` containing a totally unfaithful gadget `T` whose
  pair is non-adjacent in `H` is not an induced subgraph of any unit-distance graph on `N`
  vertices with at least `M` edges. `T` is generic: its total unfaithfulness is a hypothesis,
  discharged for the six gadgets by `UDGRope.gadget*_tu`.
- `CoverComplete`, `spine_sound` (Will, G-2 staging, 2026-10-09): a complete cover of `n`-point
  sets with at least `m` unit pairs by candidate graphs, each with no unit-distance embedding,
  shows that no such set exists.
- `realize_sound` (the G-2 yes bridge): a unit-distance embedding of a graph on `Fin n` with at
  least `m` edges gives `n` points with at least `m` unit pairs.
- `coverComplete_all` and `not_coverComplete_nil` show the definition is satisfiable and not
  vacuous: the list of all graphs on `Fin n` with at least `m` edges is complete, and the empty
  list is not complete for two points at distance 1. `coverComplete_of_all`: so is any list
  containing all of them.
-/

noncomputable section

namespace GPBinding.UDG
open UDGRope
open scoped Finset

/-- Every `n`-point set with at least `m` unit pairs contains a unit-distance copy of a graph of
`L`: an injective map into the set with every edge at distance 1 (extra unit distances allowed). -/
def CoverComplete (n m : ℕ) (L : List (SimpleGraph (Fin n))) : Prop :=
  ∀ P : Finset ℝ², P.card = n → m ≤ unitDistNum P →
    ∃ G ∈ L, ∃ f : G.UnitDistEmbedding ℝ², ∀ v, f.p v ∈ P

/-- **Spine soundness.** A complete cover whose every candidate has no unit-distance embedding
rules out `n` points with `m` unit distances. -/
theorem spine_sound {n m : ℕ} {L : List (SimpleGraph (Fin n))} (hc : CoverComplete n m L)
    (hL : ∀ G ∈ L, IsEmpty (G.UnitDistEmbedding ℝ²)) :
    ¬ ∃ P : Finset ℝ², P.card = n ∧ m ≤ unitDistNum P := by
  rintro ⟨P, hP, hm⟩
  obtain ⟨G, hG, f, -⟩ := hc P hP hm
  exact (hL G hG).false f

/-- The image of an injective map on a finite type, as a `Finset`. -/
theorem card_map_univ {n : ℕ} (f : Fin n ↪ ℝ²) : (Finset.univ.map f).card = n := by simp

/-- An unit-distance embedding's points have at least the graph's edges as unit pairs, plus every
non-edge forced to distance 1. -/
theorem edges_lt_unitDistNum {N : ℕ} (G : SimpleGraph (Fin N)) [DecidableRel G.Adj]
    (f : G.UnitDistEmbedding ℝ²) {x y : Fin N} (hxy : ¬ G.Adj x y) (hd : dist (f.p x) (f.p y) = 1) :
    #G.edgeFinset < unitDistNum (Finset.univ.map f.p) := by
  classical
  rw [unitDistNum_map]
  have hne : x ≠ y := by rintro rfl; simp at hd
  have hsub : insert s(x, y) G.edgeFinset ⊆ (unitGraph f.p).edgeFinset := by
    intro e he
    rcases Finset.mem_insert.mp he with rfl | he
    · rw [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet]; exact ⟨hne, hd⟩
    · induction e using Sym2.ind with
      | h u v =>
        have h' : G.Adj u v := by simpa using he
        rw [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet]; exact ⟨h'.ne, f.unit_dist h'⟩
  have := Finset.card_le_card hsub
  rw [Finset.card_insert_of_notMem (by simpa using hxy)] at this
  exact this

/-- **The yes bridge.** A unit-distance embedding of a graph on `Fin n` with at least `m` edges
gives `n` distinct points with at least `m` unit pairs. -/
theorem realize_sound {n m : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj]
    (hG : Nonempty (G.UnitDistEmbedding ℝ²)) (hm : m ≤ #G.edgeFinset) :
    ∃ P : Finset ℝ², P.card = n ∧ m ≤ unitDistNum P := by
  classical
  obtain ⟨f⟩ := hG
  refine ⟨Finset.univ.map f.p, card_map_univ f.p, ?_⟩
  rw [unitDistNum_map]
  refine hm.trans (Finset.card_le_card fun e he => ?_)
  induction e using Sym2.ind with
  | h u v =>
    have h' : G.Adj u v := by simpa using he
    rw [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet]; exact ⟨h'.ne, f.unit_dist h'⟩

/-- **P4 (L2, the hereditary TU rule).** Let every `N`-point set have at most `M` unit pairs
(`u(N) ≤ M`). Let `T` be totally unfaithful with pair `a b`, copied (not necessarily induced) into
`H` with the pair's image non-adjacent in `H`, and let `H` be an induced subgraph of `G` on `N`
vertices with at least `M` edges. Then `G` has no unit-distance embedding. -/
theorem tu_hereditary {N M : ℕ} (hu : ∀ P : Finset ℝ², P.card = N → unitDistNum P ≤ M)
    {k : ℕ} (T : SimpleGraph (Fin k)) (a b : Fin k)
    (hT : ∀ f : T.UnitDistEmbedding ℝ², dist (f.p a) (f.p b) = 1)
    {W : Type*} (H : SimpleGraph W) (φ : T.Copy H) (hab : ¬ H.Adj (φ a) (φ b))
    (G : SimpleGraph (Fin N)) [DecidableRel G.Adj] (ι : H ↪g G) (hM : M ≤ #G.edgeFinset) :
    IsEmpty (G.UnitDistEmbedding ℝ²) := by
  refine ⟨fun f => ?_⟩
  have hd : dist (f.p (ι (φ a))) (f.p (ι (φ b))) = 1 := hT (f.copy (ι.toCopy.comp φ))
  have hlt := edges_lt_unitDistNum G f (x := ι (φ a)) (y := ι (φ b))
    (by rw [ι.map_adj_iff]; exact hab) hd
  have := hu _ (card_map_univ f.p)
  omega

open Classical in
/-- Sanity: the list of all graphs on `Fin n` with at least `m` edges is a complete cover. -/
theorem coverComplete_all (n m : ℕ) :
    CoverComplete n m (Finset.univ.filter fun G : SimpleGraph (Fin n) => m ≤ #G.edgeFinset).toList := by
  intro P hP hm
  let e : Fin n ≃ P := (P.equivFinOfCardEq hP).symm
  let f : Fin n ↪ ℝ² := e.toEmbedding.trans (Function.Embedding.subtype _)
  have himg : Finset.univ.map f = P := by
    ext q
    simp only [Finset.mem_map, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨i, rfl⟩; exact (e i).2
    · intro hq; exact ⟨e.symm ⟨q, hq⟩, by simp [f]⟩
  refine ⟨unitGraph f, ?_, ⟨f, fun h => h.2⟩, fun v => ?_⟩
  · rw [Finset.mem_toList, Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    have := unitDistNum_map f
    rw [himg] at this
    convert hm using 1
    rw [this]
  · rw [← himg]; exact Finset.mem_map_of_mem _ (Finset.mem_univ v)

open Classical in
/-- A list that contains every graph on `Fin n` with at least `m` edges is a complete cover (the
`exhaustive` cover warrant of `gp cover`, which lists them all). -/
theorem coverComplete_of_all {n m : ℕ} {L : List (SimpleGraph (Fin n))}
    (h : ∀ G : SimpleGraph (Fin n), m ≤ #G.edgeFinset → G ∈ L) : CoverComplete n m L := by
  intro P hP hm
  obtain ⟨G, hG, hf⟩ := coverComplete_all n m P hP hm
  rw [Finset.mem_toList, Finset.mem_filter] at hG
  exact ⟨G, h G hG.2, hf⟩

/-- Sanity: the empty cover is not complete for two points at unit distance. -/
theorem not_coverComplete_nil : ¬ CoverComplete 2 1 [] := by
  intro h
  have hpq : pt 0 0 ≠ pt 1 0 := fun h' => by simpa using congrArg (fun v : ℝ² => v 0) h'
  obtain ⟨G, hG, -⟩ := h {pt 0 0, pt 1 0} (Finset.card_pair hpq) (by
    rw [unitDistNum_eq, Nat.one_le_iff_ne_zero, ← Nat.pos_iff_ne_zero, Finset.card_pos]
    refine ⟨s(pt 0 0, pt 1 0), ?_⟩
    simp only [Finset.mem_filter, Finset.mk_mem_sym2_iff, Finset.mem_insert, Finset.mem_singleton,
      true_or, or_true, and_self, Sym2.lift_mk, true_and]
    rw [dist_eq_one_iff]; simp)
  simp at hG

end GPBinding.UDG

