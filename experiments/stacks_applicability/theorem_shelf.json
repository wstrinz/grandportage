          "source_label": "algebra-lemma-NAK"
        }
      ]
    },
    {
      "tag": "01Z2",
      "official_url": "https://stacks.math.columbia.edu/tag/01Z2",
      "source_file": "limits.tex",
      "source_label": "limits-lemma-limit-nonempty",
      "environment": "lemma",
      "title": "Nonemptiness of a directed inverse limit",
      "statement_tex": "Let $S = \\lim S_i$ be the limit of a directed inverse system\nof schemes with affine transition morphisms\n(Lemma \\ref{lemma-directed-inverse-system-has-limit}).\nIf all the schemes $S_i$ are nonempty and quasi-compact,\nthen the limit $S = \\lim_i S_i$ is nonempty.",
      "statement_sha256": "3e24bd854e625d820624263fe6f0ab120972e941877ffd01951469058dcab6e1",
      "hypotheses": [
        {
          "id": "directed_inverse_system",
          "statement": "$(S_i)$ is a directed inverse system of schemes"
        },
        {
          "id": "limit_identified",
          "statement": "$S$ is the scheme limit of that system"
        },
        {
          "id": "transitions_affine",
          "statement": "all transition morphisms are affine"
        },
        {
          "id": "stages_nonempty",
          "statement": "every $S_i$ is nonempty"
        },
        {
          "id": "stages_quasi_compact",
          "statement": "every $S_i$ is quasi-compact"
        }
      ],
      "conclusion": "$S$ is nonempty",
      "dependencies": [
        {
          "tag": "01YX",
          "source_ref": "lemma-directed-inverse-system-has-limit",
          "source_label": "limits-lemma-directed-inverse-system-has-limit"
        }
      ]
    },
    {
