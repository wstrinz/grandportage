      "source_file": "algebra.tex",
      "source_label": "algebra-lemma-intersect-powers-ideal-module-zero",
      "environment": "lemma",
      "title": "Krull's intersection theorem",
      "statement_tex": "Let $R$ be a Noetherian local ring. Let $I \\subset R$ be\na proper ideal. Let $M$ be a finite $R$-module.\nThen $\\bigcap_{n \\geq 0} I^nM = 0$.",
      "statement_sha256": "a14ec52c326702ac9e2d6340d5d95797be2073670f6c0e0642ae6f007e689caf",
      "hypotheses": [
        {
          "id": "ring_noetherian_local",
          "statement": "$R$ is a Noetherian local ring"
        },
        {
          "id": "ideal_proper",
          "statement": "$I \\subset R$ is a proper ideal"
        },
        {
          "id": "module_finite",
          "statement": "$M$ is a finite $R$-module"
        }
      ],
      "conclusion": "$\\bigcap_{n \\geq 0} I^nM = 0$",
      "dependencies": [
        {
          "tag": "00IN",
          "source_ref": "lemma-Artin-Rees",
          "source_label": "algebra-lemma-Artin-Rees"
        },
        {
